  "shots": [
    {
      "id": "1-1-01",
      "studioShotId": "8713a528-fa94-4779-acc1-c66640e074c6",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-1-01/video.mp4",
      "cues": [
        {
          "start": 0.15,
          "end": 3.5,
          "kind": "caption",
          "speaker": "",
          "text": "上市前夕 · 庆功宴"
        },
        {
          "start": 3.7,
          "end": 7.5,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "双双……这帽子怎么给他了？"
        },
        {
          "start": 7.9,
          "end": 11.6,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "都要敲钟上市了。后厨往后归赵主厨。"
        }
      ]
    },
    {
      "id": "1-1-04",
      "studioShotId": "5a61f4cc-e5c7-4e13-b547-7c072ffb6da9",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-1-04/video.mp4",
      "cues": [
        {
          "start": 2.5,
          "end": 7.2,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "老叶，上市得讲门面。你那套土锅底，早该翻篇了。"
        },
        {
          "start": 7.6,
          "end": 11.6,
          "kind": "dialogue",
          "speaker": "赵帆",
          "text": "往后店里主打法式鹅肝融火锅，只接高档客。"
        }
      ]
    },
    {
      "id": "1-1-07",
      "studioShotId": "2eb1c300-fe28-4f0b-8ca7-fbb34dae84d1",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-1-07/video.mp4",
      "cues": [
        {
          "start": 0.15,
          "end": 4.4,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "撤了我家的温补底料，外地客哪受得了这重辣——"
        },
        {
          "start": 4.6,
          "end": 10.8,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "少往自己脸上贴金！没楚南铺路做推广，你现在还在小县城守破灶呢！"
        }
      ]
    },
    {
      "id": "1-1-10",
      "studioShotId": "7d709add-4d21-4bc9-ae69-0c7def64f15f",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-1-10/video.mp4",
      "cues": [
        {
          "start": 2.5,
          "end": 8.2,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "看在以前的分上，郊区仓库给你留了个位置。去不去随你。"
        },
        {
          "start": 8.5,
          "end": 12.6,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "行了叶师傅，腾地方吧，这一身草药味儿怪冲的。"
        }
      ]
    },
    {
      "id": "1-1-13",
      "studioShotId": "ea50541b-d663-48a1-b96e-7c756cc44cfe",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-1-13/video.mp4",
      "cues": []
    },
    {
      "id": "1-2-01",
      "studioShotId": "3fe172c6-2b84-4b52-81e0-8070c9b797f6",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-2-01/video.mp4",
      "cues": [
        {
          "start": 3.25,
          "end": 7.2,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "十年心血，连爷爷留的方子……全喂了狗。"
        }
      ]
    },
    {
      "id": "1-3-01",
      "studioShotId": "b53735c0-9c30-4c5b-a5af-4a1444985253",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-01/video.mp4",
      "cues": [
        {
          "start": 0.15,
          "end": 3.7,
          "kind": "caption",
          "speaker": "",
          "text": "2005年9月 · 重庆大学外餐饮街"
        },
        {
          "start": 7.1,
          "end": 11.6,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "叶寻，发什么呆呢？赶紧把你爷爷那方子拿出来呀！"
        }
      ]
    },
    {
      "id": "1-3-04",
      "studioShotId": "35e9d629-3fa3-4259-addb-63ca8d9df672",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-04/video.mp4",
      "cues": [
        {
          "start": 0.35,
          "end": 3.9,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "还没交出去……我回到试锅这天了？"
        },
        {
          "start": 4.5,
          "end": 9.5,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "双双，这九月天热得冒烟，谁进门吃火锅啊？干苦力的？"
        }
      ]
    },
    {
      "id": "1-3-06",
      "studioShotId": "c9e346c0-e4ed-4682-87a3-95d3e541aeae",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-06/video.mp4",
      "cues": [
        {
          "start": 2.3,
          "end": 7.3,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "听我的，直接改高档西餐厅！外头重大的学生就吃这套。"
        },
        {
          "start": 7.8,
          "end": 13.4,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "我也想啊，可家里账上没几个活钱了，上哪儿请西餐师傅去……"
        }
      ]
    },
    {
      "id": "1-3-09",
      "studioShotId": "c8101e8a-d97d-4683-976b-6b50860911d9",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-09/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 5.0,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "找我啊！我认识个星级西餐主厨，打声招呼的事儿。"
        },
        {
          "start": 5.4,
          "end": 10.5,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "当真？不过叶寻答应今儿试锅了……叶寻，东西呢？"
        }
      ]
    },
    {
      "id": "1-3-11",
      "studioShotId": "cc3bf549-c156-4426-9e3f-b67f7d86ae26",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-11/video.mp4",
      "cues": [
        {
          "start": 7.8,
          "end": 11.4,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "叶寻你发什么疯？！好端端撕它干嘛！"
        }
      ]
    },
    {
      "id": "1-3-15",
      "studioShotId": "7e709301-02d0-4aa6-ae97-989f0797a005",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-15/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 4.5,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "楚少不是说了吗，火锅太土，别糟蹋你家这地方。"
        },
        {
          "start": 4.9,
          "end": 10.0,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "说两句你还甩上脸子了？昨晚拍胸脯说帮我家的人是谁？"
        },
        {
          "start": 10.4,
          "end": 14.6,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "嗨，人家这是有自知之明，不好意思拿土方子出来丢人。"
        }
      ]
    },
    {
      "id": "1-3-18",
      "studioShotId": "43ac9037-aa08-4133-9a21-b6b88d6e1ac4",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-18/video.mp4",
      "cues": [
        {
          "start": 0.15,
          "end": 3.3,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "嗯。你们改西餐吧，我不掺和了。"
        },
        {
          "start": 5.9,
          "end": 9.6,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "一中午连个人影都没有，你现在甩手走人？！"
        }
      ]
    },
    {
      "id": "1-3-21",
      "studioShotId": "3e8647fa-42b8-4c66-940c-356d2afd18c1",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep01/1-3-21/video.mp4",
      "cues": [
        {
          "start": 0.15,
          "end": 2.4,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "找你的星级主厨去。"
        },
        {
          "start": 2.9,
          "end": 6.6,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "上辈子拿我当血包，这回，如你们的愿。"
        },
        {
          "start": 9.0,
          "end": 14.3,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "叶寻你给我站住！话没说清楚往哪儿走——谁准你反悔的？！"
        }
      ]
    }
  ]
}
