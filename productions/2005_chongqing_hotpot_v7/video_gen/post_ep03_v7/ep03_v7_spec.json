  "shots": [
    {
      "id": "3-1-01",
      "studioShotId": "1060e21a-9df9-46a7-ae1c-c165d4f8549f",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-01/video.mp4",
      "cues": [
        {
          "start": 3.0,
          "end": 6.8,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "夏叔，急火攻心，嗓子眼疼得像吞刀片吧？"
        },
        {
          "start": 7.2,
          "end": 12.5,
          "kind": "dialogue",
          "speaker": "夏建国",
          "text": "可不是！再闻见那股燥辣红油味儿，我这嗓子彻底交代了！"
        }
      ]
    },
    {
      "id": "3-1-04",
      "studioShotId": "d185c58b-67de-4f58-9625-a3e9a6f63639",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-04/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 6.3,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "后厨小灶借我四十分钟。熬出来您尝一口，要是烧嗓子，我拎包就走。"
        },
        {
          "start": 6.7,
          "end": 11.0,
          "kind": "dialogue",
          "speaker": "夏芊芊",
          "text": "爸，小寻从小不说空话，就让他开火试试嘛。"
        }
      ]
    },
    {
      "id": "3-1-08",
      "studioShotId": "daf332b5-e3c5-4072-873b-87d128d8a910",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-08/video.mp4",
      "cues": []
    },
    {
      "id": "3-1-11",
      "studioShotId": "67e29001-07cd-4ba1-b0d6-8bfaa6399b4e",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-11/video.mp4",
      "cues": [
        {
          "start": 2.6,
          "end": 7.0,
          "kind": "dialogue",
          "speaker": "陈伯",
          "text": "老夏，背着人炖啥好汤呢？隔半条街都闻见香了！"
        }
      ]
    },
    {
      "id": "3-1-14",
      "studioShotId": "c1b99631-5354-4464-9d52-5cba4cd78f68",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-14/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 3.4,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "夏叔，趁热抿两口原汤。"
        }
      ]
    },
    {
      "id": "3-1-18",
      "studioShotId": "851e202b-7013-421a-b144-538977ec23ea",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-18/video.mp4",
      "cues": [
        {
          "start": 2.6,
          "end": 7.8,
          "kind": "dialogue",
          "speaker": "夏建国",
          "text": "奇了……嗓子眼里那股火辣辣顶着的劲儿，真散了？！"
        },
        {
          "start": 8.2,
          "end": 11.6,
          "kind": "dialogue",
          "speaker": "夏芊芊",
          "text": "爸！你听你说话，嗓子不劈也不哑了！"
        }
      ]
    },
    {
      "id": "3-1-21",
      "studioShotId": "ca340fa6-e131-4bb4-8f46-0bd4af8c9d76",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-21/video.mp4",
      "cues": [
        {
          "start": 2.4,
          "end": 7.1,
          "kind": "dialogue",
          "speaker": "陈伯",
          "text": "老夏你可别吃独食！闻着一点不呛嗓子，赶紧给我盛一碗！"
        },
        {
          "start": 7.5,
          "end": 11.6,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "陈伯钱收回去，等过几天新锅挂牌，头一顿请您白吃。"
        }
      ]
    },
    {
      "id": "3-1-24",
      "studioShotId": "c7576259-5aac-408b-b1c2-ee2f3c392188",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-1-24/video.mp4",
      "cues": [
        {
          "start": 5.9,
          "end": 11.5,
          "kind": "dialogue",
          "speaker": "夏建国",
          "text": "小寻，叔今儿服气了！改火锅！你拿方子占五成一，往后叔听你的！"
        },
        {
          "start": 11.9,
          "end": 14.7,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "行，夏叔，咱先把字据落下来。"
        }
      ]
    },
    {
      "id": "3-2-01",
      "studioShotId": "52a7e1d8-c21f-4954-874d-5cf1cfebb2e1",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-01/video.mp4",
      "cues": [
        {
          "start": 0.15,
          "end": 3.3,
          "kind": "caption",
          "speaker": "",
          "text": "次日上午"
        }
      ]
    },
    {
      "id": "3-2-04",
      "studioShotId": "9f5c75a8-8278-45c4-af9e-85441f9e37da",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-04/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 7.0,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "赵主厨，十五万装修款我全批了，往后一个月八千块工资，店里可就指望您啦！"
        },
        {
          "start": 7.5,
          "end": 14.5,
          "kind": "dialogue",
          "speaker": "赵帆",
          "text": "林小姐把心放肚子里，等我这正宗法式西餐一开火，整条街的土馆子全得喝西北风！"
        }
      ]
    },
    {
      "id": "3-2-08",
      "studioShotId": "aa3df3e0-0891-4d94-a666-dd66a1d2c40b",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-08/video.mp4",
      "cues": [
        {
          "start": 0.35,
          "end": 4.3,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "赵帆……还真是这个光会摆盘吃回扣的混子。"
        },
        {
          "start": 4.8,
          "end": 10.17,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "喂——半个月后我们“塞纳河畔”西餐厅开业，对门冷锅冷灶的趁早关张吧！"
        }
      ]
    },
    {
      "id": "3-2-11",
      "studioShotId": "5e6a91f4-c310-4e23-9a00-532321a72bec",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-11/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 4.3,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "叶寻，瞧见没？离了你，我家照样开高档西餐厅！"
        },
        {
          "start": 4.7,
          "end": 9.4,
          "kind": "dialogue",
          "speaker": "夏建国",
          "text": "欺负人欺负到家门口了！请个洋厨子就不知道姓啥了——"
        }
      ]
    },
    {
      "id": "3-2-14",
      "studioShotId": "3d20c954-310b-48ff-9f5c-4527b5609c63",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-14/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 4.8,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "夏叔，犯不着跟他们置气。芊芊姐，账上还能腾出多少现钱？"
        },
        {
          "start": 5.2,
          "end": 10.8,
          "kind": "dialogue",
          "speaker": "夏芊芊",
          "text": "账面一共三万八，刨去欠菜贩子的货款，手里现钱就剩两万六了。"
        },
        {
          "start": 11.2,
          "end": 14.6,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "两万六够把前头改成明档了，今儿先从门口动——"
        }
      ]
    },
    {
      "id": "3-2-17",
      "studioShotId": "f5c74a3e-5744-41f8-8ffb-1c1e0280791b",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-17/video.mp4",
      "cues": [
        {
          "start": 6.0,
          "end": 10.4,
          "kind": "dialogue",
          "speaker": "夏芊芊",
          "text": "你们干什么呀！自己装修凭什么往我家门口倒沙子？！"
        }
      ]
    },
    {
      "id": "3-2-20",
      "studioShotId": "4b77643f-9e50-49a3-8acf-e9a5daa85ed6",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-20/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 5.8,
          "kind": "dialogue",
          "speaker": "赵帆",
          "text": "路窄，借你们台阶堆半个月呗，横竖你们这破店也没人登门！"
        },
        {
          "start": 6.2,
          "end": 9.4,
          "kind": "dialogue",
          "speaker": "夏建国",
          "text": "蹬鼻子上脸是吧，我跟你们拼了——"
        }
      ]
    },
    {
      "id": "3-2-23",
      "studioShotId": "7ab93461-e05e-4dd9-af7d-3624bb0b95c8",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v7/video_gen/takes_ep03/3-2-23/video.mp4",
      "cues": [
        {
          "start": 5.0,
          "end": 10.3,
          "kind": "dialogue",
          "speaker": "赵帆",
          "text": "咋的穷学生，还敢抡铁锹啊？来，往这儿拍，动一下赔十万！"
        }
      ]
    }
  ]
}
