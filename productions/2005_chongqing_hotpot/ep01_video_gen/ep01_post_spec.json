      "cues": [
        {"start": 0.0, "end": 2.3, "kind": "caption", "text": "2015年 · 双林轩火锅上市路演前夜"},
        {"start": 0.2, "end": 2.4, "kind": "caption", "text": "《叶氏清润底料配方无偿归属集团确认书》"},
        {"start": 2.0, "end": 5.9, "kind": "vo", "speaker": "叶寻", "text": "十年，我熬废右手把林双双托上顶峰。"}
      ]
    },
    {
      "id": "1-1-04",
      "studioShotId": "5ecd45cb-7d81-439c-9bbf-c380dbb92028",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-1-04/video.mp4",
      "cues": [
        {"start": 4.2, "end": 7.2, "kind": "dialogue", "speaker": "叶寻", "text": "谁让你往母汤里倒奶油的？草本回甘全毁了！"},
        {"start": 10.1, "end": 13.6, "kind": "dialogue", "speaker": "赵帆", "text": "明早路演主桌改上法式浓汤锅，原版红汤撤掉。"}
      ]
    },
    {
      "id": "1-1-07",
      "studioShotId": "6b290632-ae1d-4a2b-a97e-d58561419a04",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-1-07/video.mp4",
      "cues": [
        {"start": 0.2, "end": 2.2, "kind": "caption", "text": "调岗通知：江津老仓原料管理员"},
        {"start": 2.0, "end": 6.1, "kind": "dialogue", "speaker": "楚南", "text": "叶师傅，外资投行认海归履历，赵主厨比你体面。"},
        {"start": 6.6, "end": 9.9, "kind": "dialogue", "speaker": "叶寻", "text": "双双，方子墨迹还没干，你就撤我的灶？"}
      ]
    },
    {
      "id": "1-1-10",
      "studioShotId": "20030f78-4a35-48cf-a1a8-ed6e521154d7",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-1-10/video.mp4",
      "cues": [
        {"start": 1.0, "end": 3.2, "kind": "dialogue", "speaker": "林双双", "text": "方子已经归档入库，谁看火都一样。"},
        {"start": 4.0, "end": 7.8, "kind": "dialogue", "speaker": "叶寻", "text": "十年心血我全给了公司，连明早路演都不让我露面？"},
        {"start": 8.5, "end": 10.4, "kind": "dialogue", "speaker": "林双双", "text": "见机构要注意团队形象。"},
        {"start": 10.7, "end": 13.6, "kind": "dialogue", "speaker": "林双双", "text": "老仓清静，工资照发，你别让我为难。"}
      ]
    },
    {
      "id": "1-2-01",
      "studioShotId": "d439d47a-731e-48b0-8163-3cfeaf49fa88",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-2-01/video.mp4",
      "cues": [
        {"start": 1.6, "end": 5.6, "kind": "vo", "speaker": "叶寻", "text": "十年托举，最后连爷爷留下的根都亲手送了人……"}
      ]
    },
    {
      "id": "1-3-01",
      "studioShotId": "af98b38e-dd06-4b4d-94ce-25bc7df045ec",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-3-01/video.mp4",
      "cues": [
        {"start": 0.2, "end": 3.5, "kind": "caption", "text": "2005年9月19日 · 重庆大学沙坪坝老校区外"},
        {"start": 1.9, "end": 6.3, "kind": "vo", "speaker": "叶寻", "text": "2005年？手还没废，食单还在！"},
        {"start": 7.5, "end": 11.4, "kind": "dialogue", "speaker": "楚南", "text": "双双，你真打算听叶寻的，把馆子改成老火锅？"}
      ]
    },
    {
      "id": "1-3-04",
      "studioShotId": "0b9504b7-95a6-4014-9849-e78d6d469d89",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-3-04/video.mp4",
      "cues": [
        {"start": 2.4, "end": 4.9, "kind": "dialogue", "speaker": "楚南", "text": "外语系女生谁爱熏一身牛油味？"},
        {"start": 6.9, "end": 11.0, "kind": "dialogue", "speaker": "楚南", "text": "改成法式西餐厅，我把上海星级西厨赵帆请来给你镇场！"}
      ]
    },
    {
      "id": "1-3-07",
      "studioShotId": "73e83559-beb1-4956-9378-58dfbf59c9f1",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-3-07/video.mp4",
      "cues": [
        {"start": 1.0, "end": 6.2, "kind": "dialogue", "speaker": "林双双", "text": "叶寻，你昨天答应拿爷爷方子帮我家救店，可楚南说火锅上不了台面……"},
        {"start": 6.8, "end": 8.0, "kind": "dialogue", "speaker": "林双双", "text": "你怎么不吭声？"},
        {"start": 8.7, "end": 13.2, "kind": "vo", "speaker": "叶寻", "text": "掏心掏肺换来卸磨杀驴，这一世，这火坑你们自己跳吧。"}
      ]
    },
    {
      "id": "1-3-10",
      "studioShotId": "8c2518b3-eb6e-4c0e-afce-e12b19fadd73",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-3-10/video.mp4",
      "cues": [
        {"start": 1.0, "end": 2.2, "kind": "dialogue", "speaker": "叶寻", "text": "楚少说得对。"},
        {"start": 2.8, "end": 3.9, "kind": "dialogue", "speaker": "林双双", "text": "你说什么？"},
        {"start": 6.0, "end": 9.8, "kind": "dialogue", "speaker": "叶寻", "text": "西餐体面，我这老方子就不耽误你们发财了。"}
      ]
    },
    {
      "id": "1-3-13",
      "studioShotId": "b12d0904-fbe0-4d8c-b3d4-192ad8e1761a",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-3-13/video.mp4",
      "cues": [
        {"start": 3.9, "end": 8.2, "kind": "dialogue", "speaker": "林双双", "text": "叶寻你站住！出了这扇门，以后你求着把方子送来我都不要！"}
      ]
    },
    {
      "id": "1-4-01",
      "studioShotId": "2936556f-1a1a-4d99-9665-7e6f8fbfecfc",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-4-01/video.mp4",
      "cues": [
        {"start": 5.6, "end": 9.4, "kind": "caption", "text": "夏芊芊 · 重大会计系大四 · 青梅竹马"},
        {"start": 7.4, "end": 9.4, "kind": "dialogue", "speaker": "夏芊芊", "text": "谢谢同……小寻？！"},
        {"start": 9.6, "end": 14.2, "kind": "caption", "text": "最后通牒：桂花巷18号欠半年房租壹万捌仟元，10月8日封门"},
        {"start": 9.55, "end": 13.95, "kind": "vo", "speaker": "叶寻", "text": "十月八号封门？上辈子夏家就是这关被逼垮的，这一世换我来护！"}
      ]
    },
    {
      "id": "1-4-04",
      "studioShotId": "11084527-633a-4fac-9fed-3efb95540ff8",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot/ep01_video_gen/takes_v3/1-4-04/video.mp4",
      "cues": [
        {"start": 4.1, "end": 8.9, "kind": "dialogue", "speaker": "小石头", "text": "芊芊姐快回店！刘师傅关火背刀包要走，堂里三桌客人都拍桌子了！"}
      ]
    }
  ],
