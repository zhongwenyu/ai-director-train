  "shots": [
    {
      "id": "1-1-01",
      "studioShotId": "17b5205b-db77-4d81-9abf-efaccce20dd0",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-1-01/video.mp4",
      "cues": [
        {
          "start": 0.3,
          "end": 3.5,
          "kind": "caption",
          "speaker": "",
          "text": "2020年 · 林记集团上市敲钟前夜"
        },
        {
          "start": 5.3,
          "end": 11.2,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "叶大厨，明天集团敲钟，里头全是投行贵客，你一身牛油味往里闯，给双双丢人？"
        }
      ]
    },
    {
      "id": "1-1-04",
      "studioShotId": "dede2060-68ac-46e2-8cba-1a208a5682ff",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-1-04/video.mp4",
      "cues": [
        {
          "start": 0.3,
          "end": 5.9,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "林双双！十五年，我拿爷爷的火锅方子把林记熬到上市，过河就拆桥？！"
        },
        {
          "start": 6.6,
          "end": 13.9,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "方子是你当年上赶着献的！没楚南留洋回来做资本包装，你熬土火锅也配敲钟？遣散费打你卡上了！"
        }
      ]
    },
    {
      "id": "1-1-07",
      "studioShotId": "adbb68cc-a805-4fdf-a290-800bc1d7286e",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-1-07/video.mp4",
      "cues": []
    },
    {
      "id": "1-2-01",
      "studioShotId": "05aadbfd-a1d2-4fd8-afed-702c1f696b91",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-2-01/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 3.8,
          "kind": "caption",
          "speaker": "",
          "text": "2005年9月10日 周六傍晚 · 重庆大学外沙正街"
        },
        {
          "start": 2.4,
          "end": 9.5,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "2005年9月10号？大三刚开学……爷爷的清润火锅方子，还没交出去！"
        }
      ]
    },
    {
      "id": "1-2-04",
      "studioShotId": "c31e5a1e-e446-487f-837e-fb245fdf94f0",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-2-04/video.mp4",
      "cues": [
        {
          "start": 2.3,
          "end": 11.2,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "睡迷糊了？到饭点半桌客人都没有，馆子连亏三个月就剩四万块。你昨天说拿你家土火锅救店，算了吧。"
        }
      ]
    },
    {
      "id": "1-2-07",
      "studioShotId": "468a6ecc-3af6-4c07-b413-d1d6a070599c",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-2-07/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 6.7,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "老叶，外语系女生约会谁吃油烟土火锅？拿两万五铺白桌布改法式西餐厅，剩一万五搞开业促销！"
        },
        {
          "start": 7.0,
          "end": 8.5,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "那主厨呢？"
        },
        {
          "start": 8.7,
          "end": 14.2,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "我表哥赵帆在深圳大酒店当西餐副厨，我替你请好了，牛排五十八一份！"
        }
      ]
    },
    {
      "id": "1-2-10",
      "studioShotId": "07b349b7-7780-4686-bede-535667b31329",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-2-10/video.mp4",
      "cues": [
        {
          "start": 0.2,
          "end": 6.3,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "还是楚南见过世面！明天停业收拾，叶寻，你留下把后厨油灶刷干净打个杂。"
        },
        {
          "start": 6.9,
          "end": 11.2,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "接着吧叶大厨，灶刷亮堂点，等我表哥到了赏你口罗宋汤。"
        }
      ]
    },
    {
      "id": "1-2-13",
      "studioShotId": "f58dfd4e-0abd-4e64-9ea1-fecdce0f8e12",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-2-13/video.mp4",
      "cues": [
        {
          "start": 2.3,
          "end": 9.5,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "五十八的牛排配你们正好。方子收回，油灶你们自己刷。林双双，咱俩到此为止。"
        }
      ]
    },
    {
      "id": "1-2-16",
      "studioShotId": "331f3630-0b76-4438-9165-bdf28d671c8f",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-2-16/video.mp4",
      "cues": [
        {
          "start": 1.2,
          "end": 6.4,
          "kind": "dialogue",
          "speaker": "楚南",
          "text": "装什么硬气！掏不出三千块的穷学生，离了双双家店面，攥个破方子去哪儿开锅？"
        },
        {
          "start": 6.8,
          "end": 10.9,
          "kind": "dialogue",
          "speaker": "林双双",
          "text": "叶寻！出了这道门，明天求我也别想再进我家后厨！"
        }
      ]
    },
    {
      "id": "1-3-01",
      "studioShotId": "c03f8248-e936-4cda-ad16-d96729039990",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-3-01/video.mp4",
      "cues": [
        {
          "start": 1.6,
          "end": 8.0,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "两千八暑期工存款，哪怕摆摊，这一世绝不再给白眼狼熬一滴油！"
        }
      ]
    },
    {
      "id": "1-3-04",
      "studioShotId": "28f14a1e-f668-4d40-ba1e-bb75d32b0e64",
      "video": "/home/zhongwenyu/project/ai-director-train/productions/2005_chongqing_hotpot_v2/ep01_02_video_gen/takes_ep01/1-3-04/video.mp4",
      "cues": [
        {
          "start": 0.3,
          "end": 4.6,
          "kind": "dialogue",
          "speaker": "夏芊芊",
          "text": "小寻？上晚市了不在街中段林家帮忙，怎么往街尾跑？"
        },
        {
          "start": 5.0,
          "end": 8.8,
          "kind": "vo",
          "speaker": "叶寻",
          "text": "青梅夏芊芊，前世只有她劝我提防楚南！"
        },
        {
          "start": 9.8,
          "end": 12.1,
          "kind": "dialogue",
          "speaker": "叶寻",
          "text": "芊芊姐，夏叔出什么事了？"
        }
      ]
    }
  ]
}